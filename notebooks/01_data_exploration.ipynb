# %% [markdown]
# # 01 Data Exploration - Brent Oil Prices
# 
# This notebook performs initial EDA on the Brent oil price dataset.

# %%
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from statsmodels.tsa.stattools import adfuller, kpss

# %%
# Load data
df = pd.read_csv('../data/raw/brent_oil_prices.csv', parse_dates=['Date'], dayfirst=True)
df = df.sort_values('Date').reset_index(drop=True)
print(df.info())
df.head()

# %%
# Plot time series
plt.figure(figsize=(14,6))
plt.plot(df['Date'], df['Price'], 'b-', alpha=0.6)
plt.title('Brent Oil Prices (1987-2022)')
plt.xlabel('Date')
plt.ylabel('Price (USD/barrel)')
plt.grid(alpha=0.3)
plt.show()

# %%
# Summary statistics
print(df['Price'].describe())

# %%
# Log returns
df['log_return'] = np.log(df['Price'] / df['Price'].shift(1))
df['log_return'].hist(bins=50, figsize=(10,4))
plt.title('Distribution of Log Returns')
plt.show()

# %%
# Stationarity tests
result_adf = adfuller(df['Price'].dropna())
print('ADF p-value:', result_adf[1])
result_kpss = kpss(df['Price'].dropna())
print('KPSS p-value:', result_kpss[1])

# %%
# Volatility clustering
plt.figure(figsize=(14,4))
plt.plot(df['Date'], df['log_return'].abs(), 'g-', alpha=0.5)
plt.title('Absolute Log Returns (Volatility proxy)')
plt.show()

# %%
# Save cleaned data
df_clean = df[['Date','Price']].copy()
df_clean.to_csv('../data/processed/cleaned_oil_prices.csv', index=False)
print("Cleaned data saved.")
